# TraceMap environment template.
#
# Commit THIS file. Never commit .env — it is in .gitignore for a reason.
#
#   make env     writes .env from this template with GIT_SHA filled in
#
# ---------------------------------------------------------------------------
# Identity — M24
# ---------------------------------------------------------------------------
# This single line is what makes deploy attribution (D3) and trace-to-code (D9)
# possible. It is set here on day one, before any service exists, because
# backfilling it leaves a stretch of traces that can never be correlated to a
# release — and that gap always lands in the window you most want to analyse.
GIT_SHA=dev-local

# ---------------------------------------------------------------------------
# OpenTelemetry (wired in Phase 2; harmless now)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Head sampling stays OFF. The tail sampler decides, in the collector gateway.
OTEL_TRACES_SAMPLER=parentbased_always_on

# ---------------------------------------------------------------------------
# Storage profile: clickhouse | opensearch | badger
# ---------------------------------------------------------------------------
# Badger is the default so a first boot needs zero infrastructure, and so a
# ClickHouse problem can never be confused with an instrumentation problem.
STORAGE_PROFILE=badger

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
POSTGRES_USER=tracemap
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=tracemap
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Used from Phase 3 onward.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_DB=tracemap
CLICKHOUSE_USER=tracemap
CLICKHOUSE_PASSWORD=change-me-locally

# ---------------------------------------------------------------------------
# Baseline service latencies (ms) — LOAD-BEARING, not decoration
# ---------------------------------------------------------------------------
# payment MUST be the slowest and product a close second. That ordering is what
# makes the wall-clock / critical-path toggle visibly disagree in Phase 5: in
# wall-clock mode product looks guilty, and critical-path mode exonerates it.
# If you change these, re-validate the decoy eval case (006).
SVC_USER_BASE_MS=30
SVC_PRODUCT_BASE_MS=45
SVC_PAYMENT_BASE_MS=90

# ---------------------------------------------------------------------------
# Fault injection — M23: ALL default to zero/off
# ---------------------------------------------------------------------------
# Read per request from mutable config. Never restart to apply a fault: a
# restart perturbs latency on its own, so restarting to inject a latency fault
# measures the restart.
TRACEMAP_FAULT_DELAY_MS=0
TRACEMAP_FAULT_ERROR_RATE=0
TRACEMAP_FAULT_ENDPOINT=
TRACEMAP_FAULT_CPU_BURN_MS=0
# Backstop: faults self-heal, so a crashed eval runner cannot poison every
# subsequent measurement.
TRACEMAP_FAULT_TTL_S=600

# ---------------------------------------------------------------------------
# Service wiring
# ---------------------------------------------------------------------------
GATEWAY_PORT=3000
ORDER_PORT=3001
USER_PORT=8000
PAYMENT_PORT=8001
PRODUCT_PORT=8080

ORDER_URL=http://order-svc:3001
USER_URL=http://user-svc:8000
PAYMENT_URL=http://payment-svc:8001
PRODUCT_URL=http://product-svc:8080

# product-svc goes N+1 above this cart size — deliberate, so the Jaeger
# waterfall has something genuinely diagnosable to show in Phase 2.
PRODUCT_N_PLUS_ONE_THRESHOLD=3

# ---------------------------------------------------------------------------
# Alerting (optional at first boot; Phase 6)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# Auto-rollback ships behind a flag defaulting to OFF — M20.
AUTO_ROLLBACK_ENABLED=false

# ---------------------------------------------------------------------------
# Detector tuning (Phase 6) — the model artifact
# ---------------------------------------------------------------------------
# M8: changing any of these without re-running the eval set is the one thing
# that collapses the MLOps claim. `eval_runs.detector_cfg` records whichever
# values produced a given score, so a number can always be traced back to the
# configuration that produced it.
DETECTOR_ALPHA=0.2
DETECTOR_THRESHOLD_MS=50
DETECTOR_MIN_REQUESTS=100
DETECTOR_SUSTAINED_CYCLES=3
DETECTOR_WARMUP_CYCLES=5
DETECT_INTERVAL_S=60

# The error path's only knob. Fixed rather than learned: "normal" latency is
# genuinely environment-dependent, "normal" error rate is not — zero is the
# target, and an EWMA here would make a service that has failed 5% of requests
# all week read as healthy. 2% against a measured healthy floor of ~0.08%.
DETECTOR_ERROR_RATE_THRESHOLD=0.02

# ---------------------------------------------------------------------------
# Eval harness (Phase 7) — only read by docker-compose.eval.yml
# ---------------------------------------------------------------------------
# The harness runs OUTSIDE the stack, so it needs host routes to Redis (to
# reset alert suppression between cases) and Postgres (to record the run).
# Non-default ports on purpose: a native Postgres or Redis on the machine wins
# the bind, compose reports success anyway, and the runner then talks to the
# wrong database. Measured here — a local PostgreSQL 17 service owned 5432.
EVAL_POSTGRES_PORT=55432
EVAL_REDIS_PORT=56379

# Offered load during an eval run, and how long the generator stays up. 20 rps
# puts ~840 checkout calls in each minute-bucket, comfortably clear of the
# detector's 100-request floor.
EVAL_RPS=20
EVAL_LOAD_DURATION=9000s
