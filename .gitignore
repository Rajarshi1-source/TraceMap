# --- secrets -----------------------------------------------------------------
# .env.example is committed; .env NEVER is. (Phase 0 trap.)
.env
.env.*
!.env.example

# --- node --------------------------------------------------------------------
node_modules/
npm-debug.log*
.npm/
coverage/

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- go ----------------------------------------------------------------------
microservices/product/product
microservices/product/product.exe

# --- next.js (Phase 5) -------------------------------------------------------
.next/
out/
dist/
# Incremental typecheck cache, written by `tsc --noEmit`. A build artifact, and
# committing it makes every CI typecheck produce a spurious diff.
*.tsbuildinfo

# --- local data & runtime ----------------------------------------------------
/data/
*.log
result.json
k6-summary.json
k6out/

# Eval run artifacts. The RUN is transient; the BASELINE is committed --
# eval/baselines/main.json is what the merge gate compares against, and a
# baseline that is not in git is a gate that cannot be reviewed.
eval-report.md
eval-run.json
!eval/baselines/*.json

# --- os ----------------------------------------------------------------------
.DS_Store
Thumbs.db
